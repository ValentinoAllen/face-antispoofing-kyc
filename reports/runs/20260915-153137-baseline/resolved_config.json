{
  "experiment": {
    "run": {
      "hypothesis": "An ImageNet-pretrained mobilenetv3_large_100 fine-tuned for one epoch on a 4k train subset trains end to end on Kaggle and gives finite pooled PAD metrics on a 2k val subset.",
      "what_changed": "First baseline: binary head, no augmentation, no face crop",
      "notes": "smoke run: 1 epoch, 4k/2k subset, val subset only, no face crop, no augmentation",
      "seed": 42,
      "device": "auto"
    },
    "model": {
      "backbone": "mobilenetv3_large_100",
      "pretrained": true,
      "input_size": 224
    },
    "data": {
      "train_subset": 4000,
      "val_subset": 2000,
      "batch_size": 64,
      "num_workers": 4
    },
    "optim": {
      "lr": 0.0003,
      "weight_decay": 0.01,
      "epochs": 1
    },
    "eval": {
      "threshold": 0.5,
      "threshold_rule": "fixed_config"
    },
    "wandb": {
      "enabled": false,
      "project": "antispoof"
    }
  },
  "data": {
    "dataset_root": "/kaggle/input/datasets/attentionlayer241/celeba-spoof-for-face-antispoofing/CelebA_Spoof_/CelebA_Spoof",
    "metas_dir": "metas",
    "protocol": "intra_test",
    "train_label_file": "train_label.json",
    "test_label_file": "test_label.json",
    "conflict_policy": "exclude",
    "excluded_subjects": [
      "5028",
      "7332",
      "9735"
    ],
    "manifest_dir": "/kaggle/working/manifests",
    "split_assignment_path": "configs/splits/split_assignment.csv",
    "val_fraction": 0.1,
    "seed": 42,
    "stratify_bins": 10
  }
}
